# Safe defaults: the app builds and runs the complete deterministic Demo flow
# without any real API credentials.
DATA_MODE=mock
AI_PROVIDER=deepseek
AI_MODEL=deepseek-v4-flash

# Required whenever DATA_MODE=live. These values must remain server-only.
# Connect a free Upstash Redis integration in Vercel Storage/Marketplace to
# inject the two UPSTASH variables. CAREER_PYXIS_SESSION_SECRET must contain at
# least 32 random characters. GLOBAL_DAILY_CREDITS is the whole-deployment fuse.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CAREER_PYXIS_SESSION_SECRET=
AI_PROTECTION_GLOBAL_DAILY_CREDITS=

# Optional quota tuning. One normal first journey costs about 35 credits.
AI_PROTECTION_SESSION_DAILY_CREDITS=70
AI_PROTECTION_IP_DAILY_CREDITS=1200

# Required only when DATA_MODE=live and AI_PROVIDER=deepseek.
DEEPSEEK_API_KEY=

# Optional provider switch. Set AI_PROVIDER=openai when using these values.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
