# Safe defaults: the app builds and runs the complete deterministic Demo flow
# without any real API credentials.
DATA_MODE=mock
AI_PROVIDER=deepseek
AI_MODEL=deepseek-v4-flash

# Required only when DATA_MODE=live and AI_PROVIDER=deepseek.
DEEPSEEK_API_KEY=

# Optional provider switch. Set AI_PROVIDER=openai when using these values.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
